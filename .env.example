# Copy this file to .env to point the tests at another Conduit deployment.
# Every variable is optional: an empty value means the default named below.

# Conduit web application, the UI under test. Default: https://demo.realworld.show
BASE_URL=

# Conduit API root including the /api prefix. Default: https://api.realworld.show/api
API_URL=

# Set to 1 to run the article contract check (TC4) in failure-demo mode: the test
# really fails, with a screenshot and a trace, instead of reporting the expected
# failure inside its step. Empty or any other value keeps the normal mode.
# `npm run test:failure-demo` sets it for you.
CONTRACT_FAILURE_DEMO=
